{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicTrim",
  "version": "0.1.0",
  "identifier": "com.nemoalex.pictrim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PicTrim",
        "width": 1080,
        "height": 760,
        "minWidth": 940,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": []
  }
}
