{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicTrim",
  "version": "0.1.2",
  "identifier": "com.nemoalex.pictrim",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PicTrim",
        "width": 1040,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 880
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
